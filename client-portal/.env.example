# ===========================
# SUPABASE CONFIGURATION
# ===========================
# Create a Supabase project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================
# AUTHENTICATION
# ===========================
# Admin email - users with this email get access to /admin routes
# CRITICAL: This must match a Supabase Auth user email
ADMIN_EMAIL=your-admin-email@example.com

# ===========================
# EMAIL CONFIGURATION
# ===========================
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=your-email@example.com

# ===========================
# DATABASE (Optional - for direct queries)
# ===========================
DATABASE_URL=postgresql://user:password@host:5432/database

# ===========================
# AI SERVICES (Optional)
# ===========================
OPENAI_API_KEY=your-openai-key
GOOGLE_CALENDAR_API_KEY=your-google-calendar-key
ADOBE_SIGN_CLIENT_ID=your-adobe-client-id
ADOBE_SIGN_CLIENT_SECRET=your-adobe-client-secret
ADOBE_SIGN_TENANT_ID=your-adobe-tenant-id
