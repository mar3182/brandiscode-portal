# ==========================================
# ENVIRONMENT TEMPLATE - NEVER ADD REAL VALUES HERE
# ==========================================
# Copy to .env.local and fill in your development values.
# NEVER commit .env.local to Git.

# ==========================================
# SUPABASE
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================
# API & EXTERNAL SERVICES
# ==========================================
# Add API keys, tokens, and endpoints here
# Example:
# NEXT_PUBLIC_API_URL=http://localhost:3000
# EXTERNAL_API_KEY=your-key-here

# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=development
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# DEPLOYMENT (GitHub Actions)
# ==========================================
# These should be configured in GitHub Secrets, not here
# GITHUB_TOKEN (auto-provided by GitHub Actions)
# SUPABASE_ACCESS_TOKEN (for Supabase CLI)
